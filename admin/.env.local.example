# Supabase Dashboard -> Project Settings -> API
# Bu değerleri kopyalayıp .env.local dosyasına yapıştırın (bu dosya .gitignore'da).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard -> Project Settings -> API -> "service_role" key.
# GİZLİ TUTULMALI — asla NEXT_PUBLIC_ prefix'i eklemeyin, tarayıcıya/client
# component'e sızdırmayın. Sadece server-side (API route) kampanya push
# bildirimi gönderirken push_tokens tablosunun RLS'ini bypass edip tüm
# kullanıcıların token'larını okumak için kullanılır (bkz. lib/supabase-admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
