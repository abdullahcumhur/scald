# Supabase projesi oluşturduktan sonra bu değerleri Supabase Dashboard > Project Settings > API'den alın.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Android'de Şubeler sekmesindeki harita (react-native-maps) için gerekli.
# Google Cloud Console > APIs & Services > Credentials'tan bir API key oluşturup
# "Maps SDK for Android"ı etkinleştirin, ardından bu key'i mutlaka uygulamanın
# Android paket adına (applicationId) ve imzalama sertifikasının SHA-1
# fingerprint'ine kısıtlayın (Credentials > key > Application restrictions >
# Android apps). Bu key gizli değildir (client'a gömülür), güvenlik bu
# kısıtlamadan gelir. Boş bırakılırsa veya TODO_ ile başlıyorsa harita yerine
# uygulama içinde bir fallback kart gösterilir.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-android-api-key
